# --- PROTEÇÃO DA INFRAESTRUTURA REOBOTE CONSÓRCIOS ---

# Impedir a exibição de listagem de diretórios (Directory Listing)
Options -Indexes

# Bloquear acesso a arquivos sensíveis e dotfiles
RedirectMatch 404 /\.(git|gitattributes|github|gitignore|env|config|vercel)
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Desativar execução de scripts em pastas públicas (evita upload/execução de PHP malicioso)
<FilesMatch "\.(php|php3|php4|php5|phtml|pl|py|jsp|asp|htm|html|shtml|sh|cgi)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Tratar SEO Spam e caminhos antigos do WordPress (retorna 410 Gone para acelerar a remoção no Google)
Redirect 410 /wp-login.php
Redirect 410 /xmlrpc.php
RedirectMatch 410 /wp-content/.*
RedirectMatch 410 /wp-includes/.*
RedirectMatch 410 /wp-admin/.*

# Redirecionar erros 404 de forma limpa para a página inicial ou customizada do Next.js
ErrorDocument 404 /404

# --- CABEÇALHOS DE SEGURANÇA HTTP (SECURITY HEADERS) ---
<IfModule mod_headers.c>
    # 1. Content Security Policy (CSP)
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://www.google.com https://www.gstatic.com https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://challenges.cloudflare.com https://wa.me https://api.whatsapp.com; frame-src 'self' https://challenges.cloudflare.com https://www.google.com; media-src 'self' data: https:; object-src 'none'; base-uri 'self';"

    # 2. X-Frame-Options (Clickjacking)
    Header set X-Frame-Options "DENY"

    # 3. X-Content-Type-Options (MIME Sniffing)
    Header set X-Content-Type-Options "nosniff"

    # 4. Referrer-Policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # 5. Permissions-Policy
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"

    # 6. HSTS (Strict Transport Security - Força HTTPS)
    Header set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
</IfModule>
