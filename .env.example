# Copie este arquivo para .env.local e preencha os valores reais.
# Nunca use o prefixo NEXT_PUBLIC_* nas variáveis abaixo — elas só podem
# ser lidas no servidor (app/api/*), nunca chegar ao navegador.

# ─── Webhook do simulador (já existente) ──────────────────────────────────
WHATSAPP_WEBHOOK_URL=

# ─── Integração com o CRM (app/api/crm/*) — agendamento automático ───────
# Base da API do CRM. Só precisa ser definida se for diferente do padrão.
# CRM_API_BASE_URL=https://crm.reoboteconsorcios.com.br

# Gere uma chave NOVA em Configurações → Integrações no CRM — não
# reaproveite a mesma chave já usada pela landing page de anúncios (cada
# integração com a sua, pra poder revogar uma sem afetar a outra).
CRM_API_KEY=

# Consultor fixo que recebe hoje todo lead de agendamento (Vinícius
# Campos). Só precisa ser definida se for diferente do valor padrão
# ("cms5fphdf0000tovpws607y7a") já embutido em lib/env.ts.
# CRM_CONSULTOR_ID=cms5fphdf0000tovpws607y7a

# Webhook do n8n (workflow "agendamento-lp") que avisa o consultor e o
# supervisor via WhatsApp quando alguém agenda ou deixa uma preferência de
# horário.
CRM_NOTIFY_WEBHOOK_URL=https://reobote-n8n.to0i0r.easypanel.host/webhook/agendamento-lp
